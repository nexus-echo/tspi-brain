# TSPI AI Engine — single sample env. Copy to .env and fill in. NEVER commit real secrets.
#
# Each variable is annotated with its value for the two environments:
#   [local] = your machine (uvicorn OR `docker compose up`), zero-config defaults.
#   [prod]  = the Coolify + Supabase + Tailscale-Ollama pilot deployment.
# Env-var names map DIRECTLY to settings (no prefix): AUTH_ENABLED -> settings.auth_enabled, etc.
#
# NOTE: there is NO bundled database or Ollama container. The DB is SQLite [local] / Supabase
# [prod] via DATABASE_URL; Ollama is external in BOTH envs via OLLAMA_BASE_URL. See docker-compose.yml.

# ============================ App ============================
# [local] local      [prod] prod
TSPI_ENV=local
TSPI_LOG_LEVEL=INFO

# ============================ Database ============================
# [local] Leave UNSET -> zero-config SQLite dev DB (data/tspi.db).
# [prod]  REQUIRED -> Supabase Postgres (pgvector). Use the POOLER conn string (port 6543).
#         The DB password lives INSIDE this URL (there is no separate POSTGRES_PASSWORD).
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<supabase-pooler-host>:6543/postgres
VECTOR_BACKEND=pgvector            # pgvector (one DB) | chroma

# ============================ Embeddings ============================
# [local] hash / 384  (no deps)          [prod] ollama / 1024  (bge-m3, private)
EMBEDDING_BACKEND=hash             # [local] hash   -> [prod] ollama
EMBEDDING_DIM=384                  # [local] 384    -> [prod] 1024   (MUST match model: hash=384, bge-m3=1024)
OLLAMA_EMBEDDING_MODEL=bge-m3      # used when EMBEDDING_BACKEND=ollama (`ollama pull bge-m3`)
# Managed API backend alternative (OpenAI or OpenRouter):
# EMBEDDING_BACKEND=api
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-embeddings-key
# EMBEDDING_MODEL=text-embedding-3-small   # then EMBEDDING_DIM=1536
# EMBEDDING_API_SEND_DIMENSIONS=true       # set false for providers that reject the dimensions param (e.g. OpenRouter)
#
# OpenRouter example:
# EMBEDDING_BACKEND=api
# EMBEDDING_API_BASE=https://openrouter.ai/api/v1
# EMBEDDING_API_KEY=sk-or-your-key
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# EMBEDDING_DIM=4096                       # nemotron-3-embed-1b native output dimension
# EMBEDDING_API_SEND_DIMENSIONS=false      # OpenRouter does not accept the dimensions param

# ============================ LLM layer (report writer) ============================
# [local] deepseek (convenient)   [prod] ollama (PHI-bearing report LLM MUST be local)
LLM_PRIMARY=deepseek               # [local] deepseek -> [prod] ollama

# OpenRouter (OpenAI-compatible) — cloud LLM router, useful for local/dev. NOT on the PHI path.
# LLM_PRIMARY=openrouter
# OPENROUTER_API_KEY=sk-or-your-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# DeepSeek (OpenAI-compatible) — [local] optional convenience. [prod] NOT on the PHI path:
#   with LLM_PRIMARY=ollama it is UNUSED and the key can be omitted entirely. Only keep it if
#   you deliberately use DeepSeek for DE-IDENTIFIED-only narration.
DEEPSEEK_API_KEY=sk-your-deepseek-key    # [prod] leave empty/unset when LLM_PRIMARY=ollama
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================ Ollama endpoint ============================
# SHARED by the ollama embedding backend AND the ollama LLM. External service in BOTH envs.
# [local] http://localhost:11434  (or http://host.docker.internal:11434 from a container)
# [prod]  http://100.121.11.25:11434  (GPU box over Tailscale)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b           # [prod] your local model, e.g. qwen3:8b

# ============================ Auth / RBAC / audit (Phase B) ============================
# [local] false (pilot + MiHealth work unchanged)   [prod] true
AUTH_ENABLED=false                 # [local] false -> [prod] true
# REQUIRED when AUTH_ENABLED=true (else every caller is locked out). Comma-separated strong
# random bearer tokens — one per trusted caller (MCP, MiHealth). NEVER commit real ones.
# Generate: python -c "import secrets; print('svc-mcp-'+secrets.token_urlsafe(24))"
# [prod] SERVICE_TOKENS=svc-mihealth-REPLACE_ME,svc-mcp-REPLACE_ME
SERVICE_TOKENS=

# ============================ Governance ============================
REQUIRE_DOCTOR_VALIDATION=true     # [local] & [prod] true
ENFORCE_DEIDENTIFICATION=true      # [local] & [prod] true

# ============================ Production pilot (P1) ============================
# [local] false     [prod] true (provisional data usable, reports watermarked, no patient auto-release)
PILOT_MODE=false                   # [local] false -> [prod] true
REPORT_LANGUAGE_DEFAULT=en         # en | th  (per-request override via ?report_language=)

# ============================ PII / PHI encryption (P4) ============================
# [local] optional (unset -> identity stored PLAINTEXT, dev only).
# [prod]  REQUIRED -> patient identity (PHI) is stored ENCRYPTED. Without it, PHI is plaintext.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# [prod] ENCRYPTION_KEY=paste-a-fernet-key-here
ENCRYPTION_KEY=

# ============================ Ops (container only) ============================
WEB_CONCURRENCY=2                  # uvicorn workers (scale to CPU)
RUN_EMBED_ON_START=false           # [prod] set true ONCE to embed the KB on start (model must be pulled)
