# TSPI MCP server — copy to .env and fill in. NEVER commit real secrets.

# --- Engine (private) ---
TSPI_ENGINE_URL=http://tspi-api:8000        # internal URL of the engine pod (keep engine PRIVATE)
TSPI_ENGINE_TOKEN=svc-mcp-REPLACE_ME        # must match one of the engine's SERVICE_TOKENS

# --- Transport ---
TSPI_MCP_TRANSPORT=streamable-http          # remote/public. Use "stdio" only for local Claude Desktop.
TSPI_MCP_PORT=8080
TSPI_STRICT_DEIDENT=true

# --- OAuth (REQUIRED for a public MCP; fail-closed if set-but-misconfigured) ---
# Option A — WorkOS AuthKit (DCR; simplest for Claude.ai/ChatGPT connectors):
# TSPI_MCP_AUTH=workos
# TSPI_WORKOS_AUTHKIT_DOMAIN=https://your-project.authkit.app
# TSPI_MCP_BASE_URL=https://mcp.your-domain.com
#
# Option B — any OIDC issuer (Auth0/Keycloak/Azure/…):
# TSPI_MCP_AUTH=jwt
# TSPI_JWT_JWKS_URI=https://your-idp/.well-known/jwks.json
# TSPI_JWT_ISSUER=https://your-idp
# TSPI_JWT_AUDIENCE=tspi-mcp
#
# Claim names carrying clinician identity (defaults shown); forwarded to the engine as X-TSPI-*:
# TSPI_CLAIM_USER=sub
# TSPI_CLAIM_ROLE=role
# TSPI_CLAIM_CLINIC=clinic_id

# --- First-party apps (TSPI Digital chat at chat.tspipro.com) ---
# LibreChat logs clinicians in through the same AuthKit and forwards their access token here.
# Those tokens carry aud=<WorkOS environment client ID>, not this server's resource URL, so list
# that audience AND the chat app's WorkOS client ID (only that app is then accepted).
# TSPI_EXTRA_AUDIENCES=client_01M24VD2E06DHEPBA33GD9X0NS
# TSPI_ALLOWED_CLIENT_IDS=client_01M3NRNPC8JQT18S8BH938EAT9

# --- Local/pilot fallback identity (used only when TSPI_MCP_AUTH=none, i.e. stdio) ---
TSPI_CLINICIAN_ID=dr.example
TSPI_CLINICIAN_ROLE=clinician
# TSPI_CLINIC_ID=clinic-001
